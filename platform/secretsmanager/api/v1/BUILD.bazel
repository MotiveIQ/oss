load("@com_google_protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

# gazelle:go_generate_proto true

proto_library(
    name = "secretsmanagerv1_proto",
    srcs = ["secretsmanager.proto"],
    visibility = ["//visibility:public"],
    deps = ["@com_google_protobuf//:timestamp_proto"],
)

go_proto_library(
    name = "secretsmanagerv1_go_proto",
    compilers = [
        "@rules_go//proto:go_proto",
        "@rules_go//proto:go_grpc_v2",
    ],
    importpath = "github.com/MotiveIQ/public/platform/secretsmanager/api/v1",
    proto = ":secretsmanagerv1_proto",
    visibility = ["//visibility:public"],
)

go_library(
    name = "api",
    srcs = ["client.go"],
    embed = [":secretsmanagerv1_go_proto"],
    importpath = "github.com/MotiveIQ/public/platform/secretsmanager/api/v1",
    visibility = ["//visibility:public"],
    deps = ["@org_golang_google_grpc//:grpc"],
)

exports_files(
    ["authorization-contract.yaml"],
    visibility = ["//visibility:public"],
)
