load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "proofgrpc",
    srcs = ["transport.go"],
    importpath = "github.com/MotiveIQ/public/platform/iam/internal/proofgrpc",
    visibility = ["//platform/iam:__subpackages__"],
    deps = [
        "//platform/iam/internal/proof",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//encoding",
        "@org_golang_google_grpc//encoding/proto",
        "@org_golang_google_grpc//mem",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "proofgrpc_test",
    srcs = ["transport_test.go"],
    embed = [":proofgrpc"],
    deps = [
        "//platform/iam/internal/proof",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//encoding/gzip",
        "@org_golang_google_grpc//mem",
        "@org_golang_google_grpc//metadata",
        "@org_golang_google_grpc//status",
        "@org_golang_google_grpc//test/bufconn",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/structpb",
        "@org_golang_google_protobuf//types/known/wrapperspb",
    ],
)
