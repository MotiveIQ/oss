module(name = "motiveiq_public")

bazel_dep(name = "rules_go", version = "0.64.1")
bazel_dep(name = "gazelle", version = "0.54.0", repo_name = "bazel_gazelle")
bazel_dep(name = "protobuf", version = "36.2", repo_name = "com_google_protobuf")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(name = "go_sdk", version = "1.27.3")
use_repo(go_sdk, "go_sdk")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_coreos_go_oidc_v3",
    "com_github_go_jose_go_jose_v4",
    "org_golang_x_oauth2",
    "com_github_cedar_policy_cedar_go",
    "com_github_gofrs_flock",
    "com_github_google_uuid",
    "com_github_jmespath_go_jmespath",
    "com_github_pelletier_go_toml_v2",
    "com_github_spf13_cobra",
    "in_gopkg_yaml_v3",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_text",
)
