load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//build/iq:package.bzl", "iq_pkg")

go_library(
    name = "iq_lib",
    srcs = ["main.go"],
    importpath = "go.motiveiq.dev/cmd/iq",
    visibility = ["//visibility:private"],
    deps = ["//cmd/iq/internal/publiccli"],
)

go_binary(
    name = "iq",
    embed = [":iq_lib"],
    visibility = ["//visibility:public"],
)

iq_pkg(
    name = "package",
    binary = ":iq",
    description = "MotiveIQ API CLI and browser OIDC helper.",
    package = "iq",
    runtime_files = {"//cmd/iq/oidc:iq-oidc": "bin/iq-oidc"},
)
